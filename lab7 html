<!DOCTYPE html>
<html>
<head>
    <title>Interactive FAQ</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-r from-emerald-500 to-teal-700 flex items-center justify-center">

    <div class="bg-white p-8 rounded-xl shadow-lg w-96">

        <h2 class="text-2xl font-bold text-center text-teal-600 mb-6">
            Game with Content Creation
        </h2>

        <p class="text-center mb-5 text-gray-600">
            Frequently Asked Questions
        </p>

        <!-- FAQ 1 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded">
                How do I access the template?
            </button>

            <p class="answer hidden p-3 bg-emerald-50 text-gray-700 rounded mt-1">
                You can access template from telegram or gdrive.
            </p>
        </div>

        <!-- FAQ 2 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded">
                Where are all player gather and game is watched?
            </button>

            <p class="answer hidden p-3 bg-emerald-50 text-gray-700 rounded mt-1">
                Game reviews are held every Friday in Room 404 and streamed live on Discord.
            </p>
        </div>

        <!-- FAQ 3 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded">
                How do I submit my game clip?
            </button>

            <p class="answer hidden p-3 bg-emerald-50 text-gray-700 rounded mt-1">
                All clip must be pushed to your designated g drive before the midnight deadline.
            </p>
        </div>

    </div>

    <script>

        // Get all questions
        let questions = document.querySelectorAll(".question");

        // Add click event to each question
        questions.forEach(function(question) {

            question.addEventListener("click", function() {

                // Get the answer
                let answer = question.nextElementSibling;

                // Show / Hide answer
                answer.classList.toggle("hidden");

            });

        });

    </script>

</body>
</html>